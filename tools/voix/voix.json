 "speech": {"14":"T'as encore déplacé les meubles pour t'entraîner ?","21":"Recommence.","34":"Celui-là, je ne peux pas le combattre à ta place.","72":"Depuis trois semaines, les opérations dans le quartier ont augmenté.","122":"La prochaine fois, tu ne seras pas là pour lui, Grün.","123":"La prochaine fois, il n'aura pas besoin de moi.","134":"Pour les pierres, non.","206":"Sgrün veut l'inertie.","213":"Pourquoi ?","226":"Il a pris la dernière pierre.","235":"Restez groupés !","239":"Ce n'est pas ton père. C'est un écho de son esprit que Sgrün a capturé à sa mort.","246":"Je prends celui avec l'épée."},
 "barks": {
  "TARINE":   ["Pour Marcory ! En avant !", "Pierre de l'Équilibre, maintenant !", "C'est tout ? Au suivant !", "Pas encore... je me relève toujours."],
  "SAM":      ["Reste concentré. Ils arrivent.", "Royaume de l'Essence, ouvre-toi !", "Ce n'était qu'une ombre.", "Le passage... se referme."],
  "KAREN":    ["Personne ne touche à ma famille !", "Tenez la ligne ! Maintenant !", "Rentrez chez vous. C'est fini.", "Tarine... continue sans moi."],
  "FULGENCE": ["On ne me contourne pas. En garde !", "Je suis le mur ! Frappez donc !", "Ça a tenu. Évidemment que ça a tenu.", "Le roc... se fissure."],
  "BABA":     ["Place à la star du quartier !", "Regardez bien, je vais vous montrer le show !", "Trop facile ! Suivant !", "Ok, ok... pas aujourd'hui."],
  "LUNDGREN": ["Sept siècles d'avance. Approchez.", "Que l'eau vous emporte !", "Vous n'étiez pas prêts.", "Même les vieilles cartes se déchirent."],
  "DARK":     ["Je suis ce que tu refuses de voir.", "Regarde-toi tomber !", "Tu n'as jamais pu me battre.", "Je reviendrai... je suis toi."],
  "SYLLA":    ["À genoux devant le maître de la Villa !", "Brûle ! Que tout brûle !", "Le feu décide. Toujours.", "Ce n'est... qu'un recul."],
  "SCHISSIN": ["Je connais déjà votre nom.", "La peur a une forme. La voici.", "Classé. Dossier fermé.", "Vous... avez lu le fichier."],
  "OUSMANE":  ["Le port est à moi, petit !", "Cette fois, je ne signe rien !", "J'ai toujours été du bon côté.", "Sylla... m'a menti."],
  "SUB":      ["Cible identifiée. Exécution.", "Protocole d'installation. Aucune issue.", "Mission accomplie. Prévisible.", "Erreur... de calcul."],
  "GROB":     ["J'arrive, je casse, je repars !", "Tout va voler en éclats !", "Personne ne retiendra ton visage.", "Pas de repli... pas cette fois."],
  "KRAG":     ["Les profondeurs vous écrasent !", "Que la montagne s'effondre !", "Poussière. Rien que poussière.", "La pierre... se brise."],
  "MURK":     ["Je suis l'eau. Je suis partout.", "Gelez ! Jusqu'au sang !", "Noyé dans le silence.", "Je... m'écoule."],
  "VAEL":     ["Vous ne me verrez qu'après le coup.", "Le vent tranche ! Maintenant !", "Trop lents. Toujours trop lents.", "Le vent... tombe."],
  "SGRUN":    ["Le chaos de l'humanité me fatigue.", "Tout m'appartient ! Rendez-le moi !", "L'Empire ne perd jamais.", "Impossible... ce n'est pas calculé."],
  "KANKOU":   ["Je suis Kankou Moussa, empereur du Mali !", "Que l'or pleuve sur mes ennemis !", "Mon empire ne connaît pas la défaite.", "Même les rois tombent un jour."],
  "YASUKE":   ["Je suis Yasuke. Samouraï. En garde !", "Par la lame de Nobunaga !", "L'honneur est sauf.", "Je me relèverai. Comme toujours."]
 }
}
